# ===== LLM 网关（OpenAI 兼容端点，默认 NVIDIA NIM） =====
OPENAI_API_KEY=your-nim-or-openai-key
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.1-8b-instruct

# ===== 公平配额 / 权益（服务端可信，绝不读 body.plan） =====
AI_ENTITLEMENT_SECRET=change-me-to-a-long-random-secret
# AI_PLAN_OVERRIDE=free   # 可选：服务端强制全局 plan（测试用）

# ===== Waffo Pancake 支付（server-only，私钥绝不进客户端） =====
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENVIRONMENT=test   # test | production
WAFFO_WEBHOOK_SECRET=

# ===== 用户体系（轻量自研 JWT） =====
JWT_SECRET=change-me-to-a-long-random-secret
# 可选：将管理员邮箱加入此逗号分隔列表，登录即获 admin 角色
ADMIN_EMAILS=lixingliangsy@163.com

# ===== 反馈模块邮件（发往 lixingliangsy@163.com） =====
FEEDBACK_TO_EMAIL=lixingliangsy@163.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=gstack-noreply@yourdomain.com
# 无 SMTP 时退回控制台（开发期）：SMTP_HOST 留空即可

# ===== 分析 =====
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_UMAMI_URL=

# ===== 持久化 =====
# store 模式：file（dev 默认，写 .data/）| cloudbase（prod）
STORE_MODE=file
# CloudBase 适配器连接信息（STORE_MODE=cloudbase 时启用）
CLOUDBASE_ENV_ID=
